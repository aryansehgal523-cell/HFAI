# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="HireFlow AI Private Limited"
# Comma separated emails that get access to /admin
ADMIN_EMAILS=you@example.com

# ── Database (Neon, Supabase, RDS or local Postgres) ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hireflow

# ── Auth (NextAuth) ──────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_me
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (Anthropic) ───────────────────────────────────
ANTHROPIC_API_KEY=
# Fast model for parsing, strong model for the final resume and letter
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_STRONG_MODEL=claude-sonnet-5-5

# ── Payments (Razorpay) ──────────────────────────────
# Dashboard > Settings > API Keys (use Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Dashboard > Subscriptions > Plans: create two plans and paste their ids
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# Dashboard > Settings > Webhooks: URL https://yourdomain/api/billing/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Analytics (optional) ─────────────────────────────
# Google Analytics 4 measurement id. Loads only after the visitor allows analytics.
NEXT_PUBLIC_GA_ID=

# ── Jobs ingestion ───────────────────────────────────
# Protects /api/cron/crawl (send as Authorization: Bearer <value>)
CRON_SECRET=replace_me
CRAWLER_CONTACT_EMAIL=crawler@yourdomain.com
# "india" (default) keeps jobs in India and jobs with no country (e.g. "Remote"); "all" keeps every job
CRAWL_SCOPE=india
# Minimum gap between two requests to the same host, in milliseconds (default 1000 = one per second)
CRAWL_HOST_INTERVAL_MS=1000

# ── Chrome extension ─────────────────────────────────
# The id chrome://extensions shows for your extension. When set, /api/ext only accepts
# requests from chrome-extension://<this id>. Leave empty in development.
EXTENSION_ID=

# ── Development only ─────────────────────────────────
# Pretend today is another date (referral follow ups). Ignored in production.
# HF_DEV_NOW=2026-12-01
